# ==============================================================================
# ambideXtrous AI Portfolio - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider: Groq (Required for most agents)
# ------------------------------------------------------------------------------
# Used by: Stock Screener, HarryAgent (Router & Graph), Tour Agent
# Free API key available at: https://console.groq.com/keys
# Default model: llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Alternative & Fallback LLM Providers (Optional)
# ------------------------------------------------------------------------------
# OpenRouter is used as a fallback LLM (model: qwen/qwen3-4b:free) and as an
# alternative provider for OpenAI embeddings.
# Get API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama Cloud API key (if using remote Ollama cloud models via https://ollama.com)
# Local Ollama at http://localhost:11434 is automatically probed if running.
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# ------------------------------------------------------------------------------
# 3. Pinecone Vector DB & Neural Cross-Encoder Reranker (HarryAgent RAG)
# ------------------------------------------------------------------------------
# Pinecone API key for serverless vector database & neural reranking (pinecone-rerank-v0)
# Console: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=hpvdb-openai

# Pinecone Stdio MCP Server (@pinecone-database/mcp)
ENABLE_PINECONE_MCP=True
PINECONE_MCP_COMMAND=npx
PINECONE_MCP_ARGS=["-y", "@pinecone-database/mcp"]

# Optional OpenAI API key (for client-side text-embedding-3-small vector generation)
# If omitted, canonical BM25 retrieval over HPVdb/hp_corpus.json + Pinecone Neural Reranking is used.
OPENAI_API_KEY=your_openai_api_key_here

# Optional Cohere API key for document reranking (model: rerank-v3.5)
# Pinecone's native 'pinecone-rerank-v0' is used by default.
COHERE_API_KEY=your_cohere_api_key_here

# ------------------------------------------------------------------------------
# 4. Model Context Protocol (MCP) & Travel Tools (Tour Agent)
# ------------------------------------------------------------------------------
# Airbnb Stdio MCP Server (@openbnb/mcp-server-airbnb via npx)
ENABLE_AIRBNB_MCP=True
AIRBNB_MCP_COMMAND=npx
AIRBNB_MCP_ARGS=["-y", "@openbnb/mcp-server-airbnb", "--ignore-robots-txt"]
AIRBNB_BASE_URL=https://www.airbnb.co.in

# WeatherAPI Key (Optional - free Open-Meteo fallback is used automatically if omitted)
# Get key at: https://www.weatherapi.com/
WEATHER_API_KEY=your_weather_api_key_here

# Optional Tavily API Search Tool
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 5. Observability & Tracing: Langfuse (Optional)
# ------------------------------------------------------------------------------
# For monitoring LLM calls, latency, and agent step tracing
# Cloud console: https://cloud.langfuse.com
LANGFUSE_ENABLED=True
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ------------------------------------------------------------------------------
# 6. FastAPI Backend & Server Runtime Configuration
# ------------------------------------------------------------------------------
# Server port and host (default: 8000 on 0.0.0.0)
PORT=8000
HOST=0.0.0.0
RELOAD=false

# Default LLM model identifier
DEFAULT_MODEL=openai/gpt-oss-120b

# Hugging Face & PyTorch model cache directories
TRANSFORMERS_CACHE=/app/.cache/huggingface
HF_HOME=/app/.cache/huggingface

# Python & Deep Learning logging suppression
PYTHONUNBUFFERED=1
TF_CPP_MIN_LOG_LEVEL=3
TOKENIZERS_PARALLELISM=false
TRANSFORMERS_VERBOSITY=error

# ------------------------------------------------------------------------------
# 7. LiveKit WebRTC Voice Agent Configuration
# ------------------------------------------------------------------------------
# LiveKit Cloud Project WebSocket URL and API credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

